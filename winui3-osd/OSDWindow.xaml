<Window
    x:Class="MechrevoCustomOSD.OSDWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent" RequestedTheme="Dark">
        <Border
            x:Name="RootCard"
            Padding="14,12"
            Background="#12000000">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image
                    x:Name="IconImage"
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform" />

                <Grid Grid.Column="1" RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="TitleText"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="自定义 OSD" />
                    <TextBlock
                        x:Name="DetailText"
                        Grid.Row="1"
                        Margin="0,1,0,0"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="12"
                        Foreground="#B8FFFFFF"
                        Text="等待固件事件" />
                    <ProgressBar
                        x:Name="LevelBar"
                        Grid.Row="2"
                        Height="4"
                        Margin="0,7,0,0"
                        VerticalAlignment="Bottom"
                        Background="#40FFFFFF"
                        Foreground="#FF4A90E2"
                        IsIndeterminate="False"
                        Maximum="100"
                        Minimum="0"
                        Value="50" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
